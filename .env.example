# Copie para .env (na raiz do repo) e ajuste. Valores fictícios; o .env real NUNCA é versionado.

# --- Compose (obrigatório) ---
POSTGRES_USER=fraud
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fraud

# --- Replay (demo ao vivo) ---
REPLAY_RATE_PER_SEC=2
REPLAY_FRAUD_RATE=0.03
REPLAY_WARMUP_DAYS=35
# Aquecimento (1º boot): eventos/s. Padrão 120 (~11 min) para não sufocar a VPS de 2 núcleos; local pode usar 250+.
REPLAY_WARMUP_RATE_PER_SEC=120
REPLAY_DRIFT_FEATURE=
REPLAY_DRIFT_FACTOR=1.0

# --- API ---
SCORE_RATE_LIMIT_PER_MINUTE=10
SCORE_GLOBAL_RATE_LIMIT_PER_MINUTE=120

# --- Só para rodar Python FORA do Docker (dev local, com docker-compose.dev.yml) ---
# DATABASE_URL=postgresql://fraud:change-me@localhost:5432/fraud
# KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:29092
